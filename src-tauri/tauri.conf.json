{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Launcher",
  "version": "0.3.1",
  "identifier": "com.dsh.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DSH Launcher",
        "width": 920,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-renderer-accessibility"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
